# Daily--DSA  T.C ->O(n). s.c->O(1).
class Solution {
    public int maxLength(String s) {
        // code here
        int n = s.length();
        int open = 0, close = 0, max = 0;
        for(int i=0;i<n;i++){
            char ch = s.charAt(i);
            if(ch == '('){
                open++;
                
            }
            else{
                close++;
            }
            if(open == close){
                int len = open+close;
                max =  Math.max(max,len);
            }
            else if(close>open){
                
                open = close = 0;
            }
        }
        open = close = 0;
        for(int i=n-1;i>=0;i--){
            char ch = s.charAt(i);
            if(ch == ')'){
                close++;
                
            }
            else{
                open++;
            }
            if(open == close){
                int len = open+close;
                max =  Math.max(max,len);
            }
            else if(open>close){
                open = close = 0;
            }
        }
        return max;
    }
}
